c463g8 _18yaz4f4">Saya menikmati lingkungan kerja yang suportif dan kolaboratif. Tim saling membantu dalam menyelesaikan tugas, serta atasan memberikan arahan yang jelas sehingga pekerjaan dapat diselesaikan dengan baik. Selain itu, saya mendapatkan banyak pengalaman dan pembelajaran baru yang meningkatkan kemampuan saya.</span></div><div class="_1595km00 _11epkyf59 _11epkyfhh _11epkyf6x"><span class="_1595km00 _11epkyf4x _1yc463g0 _1yc463g3 _1yc463g1t _1yc463g8 _18yaz4f4">The challenges</span><span class="_1595km00 _11epkyf4x _1yc463g0 _1yc463g1 _1yc463g1t _1yc463g8 _18yaz4f4">Tantangan yang saya hadapi adalah manajemen waktu ketika beban kerja meningkat dan deadline cukup ketat. Namun hal ini membantu saya belajar untuk lebih disiplin, mengatur prioritas, dan bekerja lebih efisien.</span></div></div></div></div></div></div></div><div class="_1595km00" id="review-card-2"><div class="_1595km00 _11epkyf8p _11epkyf7l _11epkyfax _11epkyf9t _11epkyf5d _11epkyf69 _11epkyfi9 _11epkyf4j _11epkyf4c _1yc463g10 _1yc463g13 _11epkyf33 _11epkyf36"><div class="_1595km00 _11epkyf59 _11epkyfhh _11epkyfha _11epkyfgt _11epkyfn _10pyvlc2j _10pyvlc2o"><div class="_1595km00 _11epkyf4x _11epkyfr _11epkyfp _11epkyfhx _11epkyfi1 _11epkyfbx _11epkyfbe _11epkyf81 _11epkyf8m _6f4w8g0 _6f4w8g4"><div class="_1595km00 _11epkyf59 _11epkyfhh _11epkyf6x"><div class="_1595km00 _11epkyf59 _11epkyfhh _11epkyf6t"><div class="_1595km00 _11epkyf59 _11epkyfh9 _11epkyfgl _11epkyf6l _11epkyfhp _1qiobmr0"><span class="_1595km00 _11epkyf4x _1yc463g0 _1yc463g1 _1yc463g1t _1yc463ga _18yaz4f4"><span class="_1595km00 _10hlabl0" aria-label="4.0 out of 5"><span class="_1595km00 _11epkyf55"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" xml:space="preserve" focusable="false" fill="currentColor" width="16" height="16" class="_1595km00 _1yc463g1r _11epkyf55 _11epkyf5d _145z38o0 _145z38o2 _145z38o3 _145z38o4" aria-hidden="true"><path d="M23 9c-.1-.4-.4-.6-.8-.7l-6.4-.9-2.9-5.8c-.3-.5-.9-.7-1.4-.4-.2.1-.3.2